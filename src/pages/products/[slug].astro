---
import MainLayout from "../../layouts/MainLayout.astro";
import { catalog } from "../../lib/catalog";

export function getStaticPaths(): { params: { slug: string } }[] {
  return catalog.getAllProducts().map((product) => ({
    params: { slug: product.getSlug() },
  }));
}

const slugParam: string = Astro.params.slug ?? "";
const product = catalog.getProductBySlug(slugParam);

if (!product) {
  return Astro.redirect("/");
}
---

<MainLayout title={product.title}>
  <a class="back" href="/">← Back to products</a>

  <article class="detail">
    <img src={product.image} alt={product.title} />
    <div>
      <p class="category">{product.getCategoryLabel()}</p>
      <h1>{product.title}</h1>
      <p class="price">{product.getFormattedPrice()}</p>
      <p class:list={["stock", product.isInStock() ? "instock" : "outstock"]}>
        {product.isInStock() ? "In stock" : "Out of stock"}
      </p>
      <p class="description">{product.description}</p>
    </div>
  </article>
</MainLayout>

<style>
  .back {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
    transform: translateX(-1px);
  }
  .detail {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  .detail img {
    width: 100%;
    border-radius: 10px;
    max-height: 380px;
    object-fit: cover;
    background: #efede8;
  }
  .category {
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  h1 {
    margin-bottom: 0.5rem;
  }
  .price {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .stock {
    margin-bottom: 0.8rem;
    font-weight: 600;
  }
  .instock {
    color: #226743;
  }
  .outstock {
    color: #a13a3a;
  }
  .description {
    line-height: 1.55;
  }
  @media (min-width: 820px) {
    .detail {
      grid-template-columns: 1.15fr 1fr;
      align-items: start;
    }
  }
</style>
